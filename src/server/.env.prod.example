# Production environment for src/server/docker-compose.prod.yml

APP_NAME=Ascend
APP_PORT=8000
DEBUG=false

POSTGRES_DB=ascend
POSTGRES_USER=ascend
POSTGRES_PASSWORD=change_me_now

# JSON array of allowed origins.
# Example: ["https://api.example.com", "https://app.example.com"]
CORS_ORIGINS=["https://api.example.com"]

# Leave empty if you do not want file logging in the container.
APP_LOG_FILE=

API_KEY_PEPPER=change_me_now
ADMIN_SECRET=change_me_now

# Used by nginx and TLS documentation.
DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com
