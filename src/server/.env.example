# fastapi app
APP_NAME=Ascend
DEBUG=true
DATABASE_URL=sqlite:///./ascend.db
DATABASE_ASYNC_URL=sqlite+aiosqlite:///./ascend.db
API_KEY_PEPPER=
ADMIN_SECRET=supersecret
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","http://localhost:1420"]

# postgte database
POSTGRES_DB=ascend
POSTGRES_USER=ascend
POSTGRES_PASSWORD=ascend_dev_password

# grafana and monitoring
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# cloud storage
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
postgres_db_bucket=s3:https://storage.yandexcloud.net/your-bucket-here

# restic backups
RESTIC_PASSWORD=supersecret

# reverse proxy (Caddy)
DOMAIN=example.com
ACME_EMAIL=popa228@mail.ru