# Local SQLite defaults.
DATABASE_URL=sqlite:///./ascend.db
DATABASE_ASYNC_URL=sqlite+aiosqlite:///./ascend.db

# App settings.
APP_NAME=Ascend
DEBUG=true
API_KEY_PEPPER=
ADMIN_SECRET=supersecret

# Production HTTPS settings for Caddy.
# DOMAIN must be a real DNS name pointed at this server, e.g. api.example.com.
# ACME_EMAIL is used by Let's Encrypt for certificate notices.
DOMAIN=api.example.com
ACME_EMAIL=admin@example.com

# If your browser client is hosted on a different origin, list it here as JSON.
# Example: CORS_ORIGINS=["https://app.example.com"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000","http://localhost:1420"]

# If you want to run against Postgres outside Docker, use values like these:
# DATABASE_URL=postgresql+psycopg://ascend:ascend_dev_password@localhost:5432/ascend
# DATABASE_ASYNC_URL=postgresql+psycopg://ascend:ascend_dev_password@localhost:5432/ascend

POSTGRES_DB=ascend
POSTGRES_USER=ascend
POSTGRES_PASSWORD=ascend_dev_password

GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

S3_ACCESS_KEY_ID=yourid
S3_SECRET_ACCESS_KEY=yoursecretkey